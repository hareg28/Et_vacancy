generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// NextAuth standard models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Et_vacancy Models
enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(JOB_SEEKER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  jobSeekerProfile JobSeekerProfile?
  company          Company?
  applications     Application[]
}

model JobSeekerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  resumeUrl      String?
  bio            String?
  skills         String?  // comma separated for MVP
  education      String?
  experience     String?
  certifications String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String   @id @default(cuid())
  employerId  String   @unique
  name        String
  logoUrl     String?
  description String?
  website     String?
  industry    String?
  size        String?
  location    String?
  isVerified  Boolean  @default(false)
  
  user        User     @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jobs        Job[]
}

model Job {
  id           String   @id @default(cuid())
  companyId    String
  title        String
  description  String
  requirements String?
  salary       String?
  benefits     String?
  category     String?
  type         String?  // Full-time, Part-time
  location     String?
  remote       Boolean  @default(false)
  status       String   @default("OPEN") // OPEN, CLOSED
  deadline     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id        String   @id @default(cuid())
  jobId     String
  seekerId  String
  status    String   @default("APPLIED") // APPLIED, REVIEWED, SHORTLISTED, REJECTED, ACCEPTED
  cvUrl     String?
  coverLetter String?
  appliedAt DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker    User     @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  @@unique([jobId, seekerId])
}
